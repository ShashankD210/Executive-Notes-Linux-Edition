# Supabase configuration for account-backed storage.
# Copy this file to .env.local and fill in your project credentials.
# When unset (or left as placeholders), the app runs in Local Demo mode.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY

# Legacy anon key (use only if your project does not provide a publishable key):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY